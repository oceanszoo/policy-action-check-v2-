      "id": "O-hr-review",
      "kind": "obligation",
      "source": "Sensitive uses: qualified human-in-the-loop",
      "effective_from": "2026-11-12",
      "when": {
        "all": [
          {
            "dim": "hr",
            "not_in": [
              "none"
            ]
          },
          {
            "dim": "scope",
            "in": [
              "ind"
            ]
