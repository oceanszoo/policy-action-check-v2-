{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/pac.py\" hook session", "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/pac.py\" hook prompt", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|WebFetch|mcp__.*",
        "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/pac.py\" hook guard", "timeout": 15 } ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "policy-action-check:.*",
        "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/pac.py\" hook subagent-stop", "timeout": 30 } ]
      }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/pac.py\" hook stop", "timeout": 10 } ] }
    ]
  }
}
